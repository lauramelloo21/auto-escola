# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (só este .env.example).

# String de conexão do banco Postgres (você pega isso no Neon, Supabase, etc)
DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco?sslmode=require

# Senha que você vai usar para entrar no painel de admin em /admin
ADMIN_PASSWORD=escolha-uma-senha-forte-aqui

# Porta do servidor (o Render define isso automaticamente, pode deixar como está)
PORT=3000
